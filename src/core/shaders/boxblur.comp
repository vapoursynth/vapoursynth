/* One box blur pass over one plane, horizontal or vertical by push constant. Integer variants
   match the CPU filter's math exactly: clamped edges and (sum + rounding) / (2r+1), with the
   caller alternating the rounding term between passes the same way the CPU code does. Float
   variants accumulate in float and multiply by 1/(2r+1); they cannot be bit exact against the
   CPU's running sum, which rounds differently, so they are verified with a tolerance instead.
   Compiled four ways by the build: SAMPLE_T in {uint8_t, uint16_t} and, with FLOAT_SAMPLES,
   {float, float16_t}. */
#version 460
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#ifdef FLOAT_SAMPLES
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#endif

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, set = 0, binding = 0) readonly buffer Src { SAMPLE_T srcData[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Dst { SAMPLE_T dstData[]; };

layout(push_constant, std430) uniform Push {
    uint width;
    uint height;
    uint srcStride; /* in elements */
    uint dstStride;
    uint radius;
    uint rounding;  /* integer variants only */
    uint vertical;
    float invDiv;   /* float variants only */
} pc;

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= pc.width || y >= pc.height)
        return;

    int len = int(pc.vertical != 0u ? pc.height : pc.width);
    int pos = int(pc.vertical != 0u ? y : x);
    int stepSize = int(pc.vertical != 0u ? pc.srcStride : 1u);
    int base = int(y * pc.srcStride + x);
    int r = int(pc.radius);

#ifdef FLOAT_SAMPLES
    float acc = 0.0;
    for (int k = -r; k <= r; k++) {
        int p = clamp(pos + k, 0, len - 1);
        acc += float(srcData[uint(base + (p - pos) * stepSize)]);
    }
    dstData[y * pc.dstStride + x] = SAMPLE_T(acc * pc.invDiv);
#else
    uint acc = 0u;
    for (int k = -r; k <= r; k++) {
        int p = clamp(pos + k, 0, len - 1);
        acc += uint(srcData[uint(base + (p - pos) * stepSize)]);
    }
    dstData[y * pc.dstStride + x] = SAMPLE_T((acc + pc.rounding) / (2u * pc.radius + 1u));
#endif
}
