/* One box blur pass over one plane, horizontal or vertical by push constant, matching the CPU
   filter's integer math exactly: clamped edges and (sum + rounding) / (2r+1), with the caller
   alternating the rounding term between passes the same way the CPU code does.
   Compiled twice by the build, with SAMPLE_T defined as uint8_t and uint16_t. */
#version 460
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, set = 0, binding = 0) readonly buffer Src { SAMPLE_T srcData[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Dst { SAMPLE_T dstData[]; };

layout(push_constant, std430) uniform Push {
    uint width;
    uint height;
    uint srcStride; /* in elements */
    uint dstStride;
    uint radius;
    uint rounding;
    uint vertical;
} pc;

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= pc.width || y >= pc.height)
        return;

    int len = int(pc.vertical != 0u ? pc.height : pc.width);
    int pos = int(pc.vertical != 0u ? y : x);
    int stepSize = int(pc.vertical != 0u ? pc.srcStride : 1u);
    int base = int(y * pc.srcStride + x);

    uint acc = 0u;
    int r = int(pc.radius);
    for (int k = -r; k <= r; k++) {
        int p = clamp(pos + k, 0, len - 1);
        acc += uint(srcData[uint(base + (p - pos) * stepSize)]);
    }

    dstData[y * pc.dstStride + x] = SAMPLE_T((acc + pc.rounding) / (2u * pc.radius + 1u));
}
