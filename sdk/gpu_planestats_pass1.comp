/* Pass 1 of the plane statistics reduction: every 16x16 workgroup reduces its tile and writes
   one partial result. The per group sum fits a uint comfortably (256 samples of at most 65535),
   so 64 bit accumulation is deferred to pass 2 where it happens once instead of per pixel.
   Compiled twice with SAMPLE_T in {uint8_t, uint16_t}; the 8 and 16 bit storage features are
   in the required set every VapourSynth Vulkan device enables. */
#version 460
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, set = 0, binding = 0) readonly buffer Src { SAMPLE_T srcData[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Partials { uvec4 partials[]; }; /* sum, min, max, unused */

layout(push_constant, std430) uniform Push {
    uint width;
    uint height;
    uint stride;     /* in elements */
    uint groupCount; /* pass 2 only, shared layout */
} pc;

shared uint ssum[256];
shared uint smin[256];
shared uint smax[256];

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint t = gl_LocalInvocationIndex;

    /* Out of range threads contribute the reduction identities so partial tiles need no
       special casing anywhere else. */
    bool live = x < pc.width && y < pc.height;
    uint v = live ? uint(srcData[y * pc.stride + x]) : 0u;
    ssum[t] = v;
    smin[t] = live ? v : 0xffffffffu;
    smax[t] = live ? v : 0u;
    barrier();

    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (t < s) {
            ssum[t] += ssum[t + s];
            smin[t] = min(smin[t], smin[t + s]);
            smax[t] = max(smax[t], smax[t + s]);
        }
        barrier();
    }

    if (t == 0u)
        partials[gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x] = uvec4(ssum[0], smin[0], smax[0], 0u);
}
