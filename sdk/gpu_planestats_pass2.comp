/* Pass 2: a single workgroup folds every pass 1 partial into the final result. The plane sum
   can exceed 32 bits (an 8 megapixel 16 bit plane reaches ~5*10^11), and shaderInt64 is not in
   the required feature set, so the total is carried in two uints with uaddCarry — portable to
   every device VapourSynth accepts. */
#version 460

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) readonly buffer Partials { uvec4 partials[]; }; /* sum, min, max, unused */
layout(std430, set = 0, binding = 1) writeonly buffer Result { uvec4 result; };      /* sumLo, sumHi, min, max */

layout(push_constant, std430) uniform Push {
    uint width;  /* pass 1 only, shared layout */
    uint height;
    uint stride;
    uint groupCount;
} pc;

shared uvec2 ssum[256];
shared uint smin[256];
shared uint smax[256];

void add64(inout uvec2 acc, uint v) {
    uint carry;
    acc.x = uaddCarry(acc.x, v, carry);
    acc.y += carry;
}

void main() {
    uint t = gl_LocalInvocationIndex;
    uvec2 sum = uvec2(0u);
    uint mn = 0xffffffffu;
    uint mx = 0u;
    for (uint i = t; i < pc.groupCount; i += 256u) {
        uvec4 p = partials[i];
        add64(sum, p.x);
        mn = min(mn, p.y);
        mx = max(mx, p.z);
    }
    ssum[t] = sum;
    smin[t] = mn;
    smax[t] = mx;
    barrier();

    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (t < s) {
            uint carry;
            ssum[t].x = uaddCarry(ssum[t].x, ssum[t + s].x, carry);
            ssum[t].y += ssum[t + s].y + carry;
            smin[t] = min(smin[t], smin[t + s]);
            smax[t] = max(smax[t], smax[t + s]);
        }
        barrier();
    }

    if (t == 0u)
        result = uvec4(ssum[0].x, ssum[0].y, smin[0], smax[0]);
}
